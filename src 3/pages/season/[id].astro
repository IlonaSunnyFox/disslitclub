  8: ['https://content1.rozetka.com.ua/goods/images/big/247628542.jpg'],
  9: ['https://cdn.azbooka.ru/cv/w1100/637094cc-17cc-4d7f-a5ce-0459be236d72.jpg'],
  10: ['https://bookcover.longitood.com/bookcover?book_title=%D0%92%D0%BE%D0%B7%D0%B2%D1%80%D0%B0%D1%89%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%B2%20%D0%91%D1%80%D0%B0%D0%B9%D0%B4%D1%81%D1%85%D0%B5%D0%B4&author_name=%D0%98%D0%B2%D0%BB%D0%B8%D0%BD%20%D0%92%D0%BE&image_size=medium']
