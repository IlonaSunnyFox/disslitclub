  4: ['https://bookcover.longitood.com/bookcover?book_title=%D0%A1%D0%B5%D0%BC%D0%B8%D0%BB%D0%B5%D1%82%D0%BD%D1%8F%D1%8F%20%D0%BD%D0%BE%D1%87%D1%8C&author_name=%D0%A7%D0%BE%D0%BD%20%D0%AE%D1%87%D0%B6%D0%BE%D0%BD&image_size=medium'],
