  11: ['https://bookcover.longitood.com/bookcover?book_title=%D0%A7%D1%83%D0%BC%D0%BD%D1%8B%D0%B5%20%D0%BD%D0%BE%D1%87%D0%B8&author_name=%D0%9E%D1%80%D1%85%D0%B0%D0%BD%20%D0%9F%D0%B0%D0%BC%D1%83%D0%BA&image_size=medium']
