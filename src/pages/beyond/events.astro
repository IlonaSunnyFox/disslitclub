---
import Header from '../../components/Header.astro';
import '../../styles/global.css';
---
<html lang="ru">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Специальные события — DissLitClub</title></head>
<body><Header/><main class="wrap">
<section class="page-title"><a class="back" href="/#beyond">← За пределами текста</a><h1>Специальные события</h1><p>Лекции, дискуссии и особые встречи клуба.</p></section>
<section class="special-events-list">
  <a class="special-event-card" href="/beyond/events/summer-2025">
    <img src="/images/events/summer-2025/cover.webp" alt="Корпоратив DissLitClub — Лето 25" loading="lazy" />
    <div>
      <div class="eyebrow">05.06.2025 · DissLitClub</div>
      <h2>Корпоратив · Лето 25</h2>
      <p>Летний вечер клуба — встреча вне книжного расписания.</p>
      <span class="special-event-link">Открыть событие →</span>
    </div>
  </a>
</section>
</main></body></html>
<style>
.special-events-list{padding:0 0 72px}
.special-event-card{border:1px solid var(--line);background:rgba(255,255,255,.18);overflow:hidden;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.75fr);min-height:430px;transition:.2s}
.special-event-card:hover{transform:translateY(-3px);box-shadow:0 8px 28px #4b321812}
.special-event-card img{width:100%;height:100%;min-height:430px;object-fit:cover;object-position:center 38%;display:block}
.special-event-card>div{padding:34px;display:flex;flex-direction:column;justify-content:flex-end}
.special-event-card h2{margin:10px 0 14px;font-size:clamp(30px,3.3vw,50px);font-weight:400}
.special-event-card p{font:15px/1.55 var(--sans);margin:0 0 28px;max-width:36ch}
.special-event-link{font:13px var(--sans);color:var(--wine)}
@media(max-width:760px){.special-event-card{grid-template-columns:1fr;min-height:0}.special-event-card img{min-height:0;aspect-ratio:4/3}.special-event-card>div{padding:24px}}
</style>
