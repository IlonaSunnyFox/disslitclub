---
import Header from '../../../components/Header.astro';
import '../../../styles/global.css';
const photos = Array.from({length:18},(_,i)=>`/images/events/summer-2025/${String(i+1).padStart(2,'0')}.webp`);
---
<html lang="ru">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Корпоратив · Лето 25 — DissLitClub</title>
  <meta name="description" content="Корпоратив DissLitClub · Лето 25 · 5 июня 2025" />
</head>
<body><Header/><main>
  <section class="event-head wrap">
    <a class="back" href="/beyond/events">← Специальные события</a>
    <div class="event-meta">05.06.2025 · Лимассол</div>
    <h1>Корпоратив<br/><span>Лето 25</span></h1>
    <p>Летний вечер DissLitClub вне книжного расписания.</p>
  </section>

  <section class="event-gallery wrap" aria-label="Фотографии корпоратива DissLitClub Лето 25">
    {photos.map((src,i)=><figure class={`event-shot shot-${(i%6)+1}`}>
      <img src={src} alt="" loading={i<3?'eager':'lazy'} />
    </figure>)}
  </section>
</main></body></html>

<style>
.event-head{padding-top:52px;padding-bottom:54px;border-bottom:1px solid var(--line)}
.event-meta{font:12px var(--sans);text-transform:uppercase;letter-spacing:.12em;color:var(--wine);margin:46px 0 12px}
.event-head h1{font-size:clamp(62px,8.7vw,148px);line-height:.76;font-weight:400;margin:0;letter-spacing:-.045em}
.event-head h1 span{color:var(--wine);font-style:italic}
.event-head p{font:17px/1.5 var(--sans);margin:32px 0 0;max-width:48ch}
.event-gallery{padding-top:38px;padding-bottom:92px;display:grid;grid-template-columns:repeat(12,1fr);gap:18px}
.event-shot{margin:0;overflow:hidden;background:#e8dcc8;min-height:260px}
.event-shot img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}
.event-shot:hover img{transform:scale(1.015)}
/* sequence: intimacy → wide scene → close frame → group; repeat */
.shot-1{grid-column:1/8;aspect-ratio:4/3}.shot-2{grid-column:8/13;aspect-ratio:3/4}
.shot-3{grid-column:1/5;aspect-ratio:3/4}.shot-4{grid-column:5/13;aspect-ratio:16/9}
.shot-5{grid-column:1/7;aspect-ratio:4/3}.shot-6{grid-column:7/13;aspect-ratio:4/3}
@media(max-width:760px){
  .event-head{padding-top:34px;padding-bottom:38px}.event-meta{margin-top:32px}
  .event-gallery{display:block;padding-top:16px}.event-shot{aspect-ratio:auto!important;margin:0 0 12px}.event-shot img{height:auto;max-height:none}
}
</style>
