---
import Header from '../../../components/Header.astro';
import '../../../styles/global.css';
const photos = [
  { src: '/images/events/summer-2026/01.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/02.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/03.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/04.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/05.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/06.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/07.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/08.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/09.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/10.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/11.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/12.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/13.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/14.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/15.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/16.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/17.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/18.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/19.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/20.webp', orientation: 'landscape' },
  { src: '/images/events/summer-2026/21.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/22.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/23.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/24.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/25.webp', orientation: 'portrait' },
  { src: '/images/events/summer-2026/26.webp', orientation: 'landscape' },
];
---
<html lang="ru">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Корпоратив · Летний 2026 — DissLitClub</title>
  <meta name="description" content="Корпоратив DissLitClub · Летний 2026" />
</head>
<body><Header/><main>
  <section class="event-head wrap">
    <a class="back" href="/beyond/events">← Специальные события</a>
    <div class="event-meta">Лето 2026 · Лимассол</div>
    <h1>Корпоратив<br/><span>Летний 2026</span></h1>
    <p>Летняя встреча DissLitClub вне книжного расписания.</p>
  </section>

  <section class="event-gallery wrap" aria-label="Фотографии корпоратива DissLitClub Летний 2026">
    {photos.map((photo,i)=><figure class={`event-shot ${photo.orientation}`}>
      <img src={photo.src} alt="" loading={i<4?'eager':'lazy'} />
    </figure>)}
  </section>
</main></body></html>

<style>
.event-head{padding-top:52px;padding-bottom:54px;border-bottom:1px solid var(--line)}
.event-meta{font:12px var(--sans);text-transform:uppercase;letter-spacing:.12em;color:var(--wine);margin:46px 0 12px}
.event-head h1{font-size:clamp(62px,8.7vw,148px);line-height:.76;font-weight:400;margin:0;letter-spacing:-.045em}
.event-head h1 span{color:var(--wine);font-style:italic}
.event-head p{font:17px/1.5 var(--sans);margin:32px 0 0;max-width:48ch}
.event-gallery{padding-top:38px;padding-bottom:92px;display:grid;grid-template-columns:repeat(12,1fr);gap:18px;align-items:start}
.event-shot{margin:0;overflow:hidden;background:#e8dcc8}
.event-shot.landscape{grid-column:span 6;aspect-ratio:3/2}
.event-shot.portrait{grid-column:span 4;aspect-ratio:2/3}
.event-shot img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}
.event-shot:hover img{transform:scale(1.015)}
@media(max-width:900px){.event-shot.landscape{grid-column:span 12}.event-shot.portrait{grid-column:span 6}}
@media(max-width:760px){
  .event-head{padding-top:34px;padding-bottom:38px}.event-meta{margin-top:32px}
  .event-gallery{grid-template-columns:repeat(2,1fr);gap:10px;padding-top:16px}
  .event-shot.landscape{grid-column:span 2;aspect-ratio:3/2}
  .event-shot.portrait{grid-column:span 1;aspect-ratio:2/3}
}
</style>
