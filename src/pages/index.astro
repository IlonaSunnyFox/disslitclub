---
import Header from '../components/Header.astro';
import {seasons, meetings, authorEvents} from '../data/meetings.js';
import '../styles/global.css';

const sortedAuthorEvents = [...authorEvents].sort((a,b) => Number(Boolean(b.image)) - Number(Boolean(a.image)));
const authorEventsFirstRow = sortedAuthorEvents.slice(0,4);
const authorEventsRest = sortedAuthorEvents.slice(4);
---
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DissLitClub — закрытый книжный клуб в Лимассоле</title>
  <meta name="description" content="DissLitClub — закрытый книжный клуб в Лимассоле. С 2020 года встречаемся раз в три недели. Участие по приглашению." />
</head>
<body>
  <Header />
  <main>
    <section class="hero-home wrap" id="about">
      <div class="hero-copy">
        <h1>Усилие<br/>без насилия</h1>
        <h2>Закрытый книжный клуб</h2>
        <p class="club-intro">с 2020 года встречаемся<br/>в Лимассоле раз в три недели.<br/>Участие по приглашению.</p>
        <div class="hero-stats" aria-label="DissLitClub в цифрах">
          <div><strong>2020</strong><span>год основания</span></div>
          <div><strong>7</strong><span>сезонов</span></div>
          <div><strong>60+</strong><span>встреч</span></div>
          <div><strong>60+</strong><span>книг</span></div>
          <div><strong>6</strong><span>коммуникаций<br/>с авторами</span></div>
          <div><strong>раз в <b>3</b> недели</strong><span>встречаемся</span></div>
        </div>
      </div>
      <div class="hero-photo" aria-label="Встреча DissLitClub в Лимассоле">
        <img src="/images/club-hero.jpg" alt="Встреча DissLitClub в Лимассоле" />
      </div>
    </section>

    <section class="home-section wrap" id="authors">
      <div class="home-section-title">
        <h2>Авторы × DissLitClub</h2>
        <a href="#authors">Все встречи с авторами →</a>
      </div>
      <div class="authors-home">
        {authorEventsFirstRow.map((m) =>
          <a class="author-home-card" href={m.href || `/meeting/${m.slug}`}>
            {m.image && <img class="author-home-photo" src={m.image} alt="" loading="lazy" />}
            <div class="author-home-name">{m.author}</div>
            <div class="author-home-book">{m.title === 'Творческая встреча' || m.title === 'Закрытая лекция с режиссером' ? m.title : `«${m.title}»`}</div>
            <div class="author-home-event">{m.authorEvent}</div>
            <div class="author-home-season">{m.date || (m.season ? `${m.season} сезон` : '')}</div>
          </a>
        )}
        {authorEventsRest.length > 0 && (
          <>
            <div class="author-events-more" id="author-events-more">
              {authorEventsRest.map((m) =>
                <a class="author-home-card" href={m.href || `/meeting/${m.slug}`}>
                  {m.image && <img class="author-home-photo" src={m.image} alt="" loading="lazy" />}
                  <div class="author-home-name">{m.author}</div>
                  <div class="author-home-book">{m.title === 'Творческая встреча' || m.title === 'Закрытая лекция с режиссером' ? m.title : `«${m.title}»`}</div>
                  <div class="author-home-event">{m.authorEvent}</div>
                  <div class="author-home-season">{m.date || (m.season ? `${m.season} сезон` : '')}</div>
                </a>
              )}
            </div>
            <button class="author-events-toggle" type="button" aria-controls="author-events-more" aria-expanded="false">Все встречи</button>
          </>
        )}
      </div>
    </section>

    <section class="home-section wrap" id="archive">
      <div class="home-section-title">
        <h2>Архив сезонов</h2>
        <span class="section-note">Каждая встреча открывается отдельно</span>
      </div>
      <div class="season-strip">
        {seasons.map((s) =>
          <a class={`season-tile season-${s.id}`} href={`/season/${s.id}`}>
            <div class="season-number">0{s.id}</div>
            <div class="season-years">{s.years.replace('–',' / ')}</div>
            <div class="season-visual" aria-hidden="true"><span>{s.id === 7 ? 'текущий сезон' : `${s.meetings.length} встреч`}</span></div>
          </a>
        )}
      </div>
    </section>

    <section class="home-section wrap" id="beyond">
      <div class="home-section-title">
        <h2>За пределами текста</h2>
      </div>
      <div class="beyond-home">
        <a class="beyond-card theatre" href="/beyond/theatre">
          <span class="beyond-icon">◐</span><div><h3>Театр</h3><p>Наши походы в театр и обсуждения спектаклей.</p></div>
        </a>
        <a class="beyond-card cinema" href="/beyond/cinema">
          <span class="beyond-icon">▰</span><div><h3>Киноклуб</h3><p>Отдельные кинопросмотры и обсуждения.</p></div>
        </a>
        <a class="beyond-card events" href="/beyond/events">
          <span class="beyond-icon">✶</span><div><h3>Специальные события</h3><p>Лекции, дискуссии и особые встречи.</p></div>
        </a>
      </div>
    </section>

    <section class="current-mini wrap">
      <div><span>Сейчас в клубе</span><strong>07 / 01</strong></div>
      <div><span>16.09.2026 · открытие седьмого сезона</span><strong>Фёдор Достоевский · «Бесы»</strong></div>
      <a href="/meeting/s7-бесы">О встрече →</a>
    </section>
  </main>
  <footer class="footer wrap"><span>© 2026 DissLitClub · Лимассол, Кипр</span><span>RU / EN</span></footer>
</body>
</html>

<script is:inline data-author-events-toggle-script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.author-events-toggle');
    const more = document.querySelector('.author-events-more');
    if (!btn || !more) return;
    btn.addEventListener('click', () => {
      const open = more.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Скрыть' : 'Все встречи';
    });
  });
</script>
