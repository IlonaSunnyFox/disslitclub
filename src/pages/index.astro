---
import Header from '../components/Header.astro';
import {seasons, meetings, authorEvents} from '../data/meetings.js';
import '../styles/global.css';
const count=meetings.length;
---
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>DissLitClub — закрытый книжный клуб в Лимассоле</title><meta name="description" content="DissLitClub — закрытый книжный клуб в Лимассоле. С 2020 года встречаемся раз в три недели. Участие по приглашению."/></head><body>
<Header/>
<main class="wrap">
<section class="hero"><div><div class="eyebrow">DissLitClub · Limassol · Cyprus · since 2020</div><h1>Усилие<br/>без насилия.</h1><p>Закрытый книжный клуб в Лимассоле.</p></div><div class="hero-note">С 2020 года встречаемся раз в три недели.<br/>Участие по приглашению.</div></section>
<section class="stats"><div class="stat"><strong>2020</strong><span>основан клуб</span></div><div class="stat"><strong>7</strong><span>сезонов</span></div><div class="stat"><strong>{count}+</strong><span>зафиксированных встреч</span></div><div class="stat"><strong>3</strong><span>недели между встречами</span></div></section>
<section class="section" id="authors"><div class="section-head"><h2>Авторы × DissLitClub</h2><p>Личные встречи, разговоры с клубом и коммуникации с авторами вокруг наших презентаций.</p></div><div class="author-grid">{authorEvents.map((m,i)=><a class="author-card" href={`/meeting/${m.slug}`}><span class="num">0{i+1} / AUTHOR</span><div><h3>{m.author}</h3><p>«{m.title}»</p></div><small>{m.authorEvent}</small></a>)}</div></section>
<section class="section" id="archive"><div class="section-head"><h2>Архив сезонов</h2><p>Каждая книга ведёт на отдельную страницу встречи. Даты, оценки и материалы можно добавлять постепенно.</p></div><div class="season-grid">{seasons.map(s=><a class="season-card" href={`/season/${s.id}`}><strong>0{s.id}</strong><span>{s.years}</span><em>{s.meetings.length} встреч</em></a>)}</div></section>
<section class="section" id="beyond"><div class="section-head"><h2>За пределами текста</h2><p>Клуб существует не только между страницами.</p></div><div class="beyond"><div class="feature"><div class="eyebrow">Theatre</div><h3>Театр</h3><p>Совместные походы клуба в театр. Архив спектаклей, дат и фотографий добавим следующим этапом.</p></div><div class="feature"><div class="eyebrow">Film club</div><h3>Киноклуб</h3><p>Кино как продолжение разговора: отдельные встречи клуба вокруг фильмов и экранизаций.</p></div><div class="feature"><div class="eyebrow">Special events</div><h3>Специальные события</h3><p>Авторские встречи, разговоры и другие события вокруг литературы.</p></div></div></section>
<section class="section"><div class="current"><div><div class="eyebrow">Сейчас в клубе · 07 / 01</div><h3>16.09</h3><p>Открытие седьмого сезона</p></div><div><div class="book">Фёдор Достоевский<br/><strong>«Бесы»</strong></div><p style="margin:25px 0"><a class="back" href="/meeting/s7-бесы">О встрече →</a></p></div></div></section>
</main><footer class="footer wrap"><span>© 2026 DissLitClub · Limassol, Cyprus</span><span>RU · EN — English version in progress</span></footer>
</body></html>
