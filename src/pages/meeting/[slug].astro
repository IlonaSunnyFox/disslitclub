---
import Header from '../../components/Header.astro'; import {meetings} from '../../data/meetings.js'; import '../../styles/global.css';
export function getStaticPaths(){return meetings.map(m=>({params:{slug:m.slug},props:{m}}))}
const {m}=Astro.props;
---
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{m.title} — DissLitClub</title></head><body><Header/><main class="wrap"><section class="meeting-hero"><a class="back" href={`/season/${m.season}`}>← Сезон 0{m.season}</a><div class="meta" style="margin-top:45px"><span>Сезон 0{m.season} / встреча {String(m.number).padStart(2,'0')}</span>{m.date&&<span>{m.date}</span>}{m.note&&<span>{m.note}</span>}</div><h1>{m.title}</h1><div class="author">{m.author}</div>{m.authorEvent&&<p class="badge" style="margin-top:30px">Автор × DissLitClub · {m.authorEvent}</p>}</section><section class="content-grid"><aside><div class="eyebrow">Оценки встречи</div><div class="score-box"><span>Оценка клуба</span><strong>— / 10</strong></div><div class="score-box"><span>Литературный интерес</span><strong>— / 10</strong></div><div class="score-box"><span>Дискуссионный потенциал</span><strong>— / 10</strong></div><p style="font:12px var(--sans);color:var(--muted);line-height:1.6">Оценки добавим после восстановления данных по встречам.</p></aside><div><div class="material"><div class="eyebrow">Презентация</div><h2>Материалы встречи</h2><div class="placeholder">PDF-презентация пока не добавлена. Когда файл появится, здесь будет обложка и кликабельная ссылка «Открыть презентацию».</div></div>{m.youtube?<div class="material"><div class="eyebrow">Видео</div><h2>{m.mediaLabel||'Видео встречи'}</h2><div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${m.youtube}`} title={`${m.title} — DissLitClub`} allowfullscreen></iframe></div></div>:<div class="material"><div class="eyebrow">Видео</div><div class="placeholder">Видео для этой встречи пока не опубликовано.</div></div>}<div class="material"><div class="eyebrow">Фотографии</div><div class="placeholder">Галерея пока не добавлена. Сюда можно будет загрузить фотографии встречи без изменения шаблона страницы.</div></div></div></section></main></body></html>
