---
import Header from '../../components/Header.astro';
import {seasons,meetings} from '../../data/meetings.js';
import {quoteBookTitle} from '../../utils/display.js';
import '../../styles/global.css';
import coverManifest from '../../data/cover-manifest.js';
export function getStaticPaths(){return seasons.map(s=>({params:{id:String(s.id)},props:{season:s}}))}
const {season}=Astro.props;
const list=meetings.filter(m=>m.season===season.id);
const seasonIndex=seasons.findIndex(s=>s.id===season.id);
const prevSeason=seasonIndex>0 ? seasons[seasonIndex-1] : null;
const nextSeason=seasonIndex<seasons.length-1 ? seasons[seasonIndex+1] : null;

---
<html lang="ru">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Сезон {season.id} — DissLitClub</title></head>
<body>
<Header/>
<main class="wrap season-page">
  <section class="season-head">
    <div>
      <a class="back" href="/#archive">← Архив сезонов</a>
      <div class="season-kicker">DissLitClub / {season.years}</div>
      <h1>Сезон <span>0{season.id}</span></h1>
    </div>
    <div class="season-summary"><strong>{String(list.length).padStart(2,'0')}</strong><span>встреч<br/>в сезоне</span></div>
  </section>

  <section class="season-catalog" aria-label={`Встречи сезона ${season.id}`}>
    {list.map((m,i)=>{
      const curatedCovers = coverManifest?.[season.id]?.[m.number] || null;
      return <a class="meeting-card" href={`/meeting/${m.slug}`}>
      {curatedCovers ? (
        <div class:list={["meeting-cover-shell", {"is-dual": curatedCovers.length > 1}]}>
          <div class="meeting-cover-fallback" aria-hidden="true">
            <span>{m.author}</span>
            <strong>{quoteBookTitle(m.title)}</strong>
          </div>
          {curatedCovers.map((src, coverIndex) => (
            <img
              class="meeting-cover is-loaded meeting-cover-curated"
              src={src}
              alt={curatedCovers.length > 1 ? `Обложка ${coverIndex + 1} встречи ${quoteBookTitle(m.title)}` : `Обложка книги ${quoteBookTitle(m.title)}`}
              loading="lazy"
              referrerpolicy="no-referrer"
              data-curated-cover
              data-title={m.title.split(' / ')[0].replace(/[«»]/g,'')}
              data-author={m.author.split(' / ')[0]}
            />
          ))}
        </div>
      ) : (
        <div class="meeting-cover-shell">
          <div class="meeting-cover-fallback" aria-hidden="true">
            <span>{m.author}</span>
            <strong>{quoteBookTitle(m.title)}</strong>
          </div>
          <img
            class="meeting-cover"
            data-book-cover
            data-title={m.title.split(' / ')[0].replace(/[«»]/g,'')}
            data-author={m.author.split(' / ')[0]}
            alt={`Обложка книги ${quoteBookTitle(m.title)}`}
            loading="lazy"
          />
        </div>
      )}
      <div class="meeting-card-content">
        <div class="meeting-card-top">
          <span class="meeting-no">{String(i+1).padStart(2,'0')}</span>
          <div class="meeting-marks">
            {m.authorEvent&&<span>Автор × DLC</span>}
            {m.youtube&&<span>Видео</span>}
            {m.date&&<span>{m.date}</span>}
          </div>
        </div>
        <div class="meeting-card-body">
          <h2>{quoteBookTitle(m.title)}</h2>
          <p>{m.author}</p>
        </div>
        <div class="meeting-card-arrow">Открыть встречу <span>↗</span></div>
      </div>
    </a>})}
  </section>

  <nav class="season-switcher" aria-label="Навигация по сезонам">
    {prevSeason ? (
      <a class="season-switch season-switch-prev" href={`/season/${prevSeason.id}`}>
        <span class="season-switch-direction">← Предыдущий сезон</span>
        <span class="season-switch-title">Сезон {String(prevSeason.id).padStart(2,'0')}</span>
        <span class="season-switch-years">{prevSeason.years}</span>
      </a>
    ) : (
      <span class="season-switch season-switch-empty" aria-hidden="true"></span>
    )}

    <a class="season-switch-archive" href="/#archive">Все сезоны</a>

    {nextSeason ? (
      <a class="season-switch season-switch-next" href={`/season/${nextSeason.id}`}>
        <span class="season-switch-direction">Следующий сезон →</span>
        <span class="season-switch-title">Сезон {String(nextSeason.id).padStart(2,'0')}</span>
        <span class="season-switch-years">{nextSeason.years}</span>
      </a>
    ) : (
      <span class="season-switch season-switch-empty" aria-hidden="true"></span>
    )}
  </nav>

  <style>
    .season-switcher{
      display:grid;
      grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);
      gap:18px;
      align-items:stretch;
      margin:64px 0 18px;
      padding-top:28px;
      border-top:1px solid rgba(102,21,27,.2);
    }
    .season-switch{
      min-height:132px;
      padding:22px 24px;
      border:1px solid rgba(102,21,27,.22);
      border-radius:12px;
      background:rgba(255,255,255,.16);
      color:inherit;
      text-decoration:none;
      display:flex;
      flex-direction:column;
      justify-content:center;
      transition:transform .2s ease,border-color .2s ease,background .2s ease;
    }
    a.season-switch:hover{
      transform:translateY(-3px);
      border-color:rgba(102,21,27,.55);
      background:rgba(102,21,27,.035);
    }
    .season-switch-next{ text-align:right; align-items:flex-end; }
    .season-switch-direction{
      font-size:12px;
      letter-spacing:.09em;
      text-transform:uppercase;
      color:#66151b;
      opacity:.78;
      margin-bottom:13px;
    }
    .season-switch-title{
      font-size:clamp(24px,2.2vw,34px);
      line-height:1;
      letter-spacing:-.02em;
    }
    .season-switch-years{
      margin-top:8px;
      font-size:13px;
      opacity:.58;
    }
    .season-switch-archive{
      align-self:center;
      color:#66151b;
      text-decoration:none;
      white-space:nowrap;
      font-size:13px;
      letter-spacing:.04em;
      padding:12px 4px;
      border-bottom:1px solid rgba(102,21,27,.3);
    }
    .season-switch-archive:hover{ border-bottom-color:#66151b; }
    .season-switch-empty{ visibility:hidden; }
    @media(max-width:760px){
      .season-switcher{
        grid-template-columns:1fr 1fr;
        gap:10px;
        margin-top:46px;
      }
      .season-switch{ min-height:112px; padding:17px 16px; }
      .season-switch-title{ font-size:22px; }
      .season-switch-direction{ font-size:10px; letter-spacing:.06em; margin-bottom:10px; }
      .season-switch-years{ font-size:12px; }
      .season-switch-archive{ grid-column:1/-1; grid-row:2; justify-self:center; margin-top:4px; }
      .season-switch-empty{ display:block; }
    }
  </style>
  <script>
    const resolveCoverApi = async (url) => {
      const response = await fetch(url);
      if (!response.ok) throw new Error('cover lookup failed');
      const data = await response.json();
      if (!data.url) throw new Error('cover not found');
      return data.url;
    };

    const fallbackCover = async (img) => {
      if (img.dataset.fallbackTried) return;
      img.dataset.fallbackTried = '1';
      const title = img.dataset.title || '';
      const author = img.dataset.author || '';
      try {
        const endpoint = `https://bookcover.longitood.com/bookcover?book_title=${encodeURIComponent(title)}&author_name=${encodeURIComponent(author)}&image_size=medium`;
        img.src = await resolveCoverApi(endpoint);
      } catch (_) {
        img.remove();
      }
    };

    document.querySelectorAll('[data-curated-cover]').forEach(async (img) => {
      img.addEventListener('error', () => fallbackCover(img));
      if (img.src.includes('bookcover.longitood.com/bookcover?')) {
        try {
          const apiUrl = img.src;
          img.removeAttribute('src');
          img.src = await resolveCoverApi(apiUrl);
        } catch (_) {
          fallbackCover(img);
        }
      }
    });

    const covers = document.querySelectorAll('[data-book-cover]');
    const loadCover = async (img) => {
      if (img.dataset.loaded) return;
      img.dataset.loaded = '1';
      const title = img.dataset.title || '';
      const author = img.dataset.author || '';
      try {
        const endpoint = `https://bookcover.longitood.com/bookcover?book_title=${encodeURIComponent(title)}&author_name=${encodeURIComponent(author)}&image_size=medium`;
        img.src = await resolveCoverApi(endpoint);
        img.addEventListener('load', () => img.classList.add('is-loaded'), {once:true});
      } catch (_) {
        img.remove();
      }
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          loadCover(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, {rootMargin:'300px'});
    covers.forEach(img => observer.observe(img));
  </script>
</main>
</body>
</html>
